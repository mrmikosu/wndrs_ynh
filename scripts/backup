#!/bin/bash

# Keep this path for calling _common.sh inside backup/restore context
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

# Helpers 2.1: positional path only — NOT --src_path=
ynh_backup "$install_dir"

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

dashboard_domain=$(ynh_app_setting_get --key=dashboard_domain)
if [[ -n "$dashboard_domain" && -e "/etc/nginx/conf.d/${dashboard_domain}.d/${app}-dashboard.conf" ]]; then
  ynh_backup "/etc/nginx/conf.d/${dashboard_domain}.d/${app}-dashboard.conf"
fi

if [[ -e "/etc/php/${php_version}/fpm/pool.d/$app.conf" ]]; then
  ynh_backup "/etc/php/${php_version}/fpm/pool.d/$app.conf"
fi

if [[ -e "/etc/systemd/system/$app.service" ]]; then
  ynh_backup "/etc/systemd/system/$app.service"
fi

ynh_print_info "Backup script completed for $app."
