#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================
source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STORE SETTINGS
#=================================================
ynh_app_setting_set --key=dashboard_domain --value="$dashboard_domain"
ynh_app_setting_set --key=admin_email --value="$admin_email"
ynh_app_setting_set --key=dashboard_admin --value="$dashboard_admin"
ynh_app_setting_set --key=php_upload_max_filesize --value=32M
ynh_app_setting_set --key=php_post_max_size --value=32M

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Prefer bundled sources/app.tar.gz (ZIP custom install). Falls back to manifest URL.
if [[ -f "../sources/app.tar.gz" ]]; then
  mkdir -p "$install_dir"
  tar -xzf "../sources/app.tar.gz" -C "$install_dir"
else
  ynh_setup_source --dest_dir="$install_dir"
fi

mkdir -p "$install_dir/www/os/data/analytics/geo"
mkdir -p "$install_dir/www/os/uploads"
mkdir -p "$install_dir/dashboard/data"
chmod 700 "$install_dir/dashboard/data"

#=================================================
# APP CONFIGURATION
#=================================================
ynh_script_progression "Writing configuration..."

base_path="${path%/}/os"
public_home="${path%/}/"
# Ensure leading slash style
[[ "$base_path" == os ]] && base_path="/os"
[[ "$public_home" == "/" ]] || public_home="${path%/}/"

csrf_key="$(ynh_string_random --length=48)"
cron_token="$(ynh_string_random --length=32)"
member_password="$(ynh_string_random --length=16)"
team_password="$(ynh_string_random --length=16)"
site_key="$(ynh_string_random --length=32)"
analytics_secret="$(ynh_string_random --length=48)"

# Origins for collector (HTTPS domain variants)
origins_php="['https://${domain}', 'https://www.${domain}']"

# Export for ynh_config_add replacements (__VAR__ <- $var)
# ynh_config_add replaces __FOO_BAR__ with $foo_bar
admin_password="$password"
# base_path, public_home, csrf_key, cron_token, admin_email,
# member_password, team_password, site_key, analytics_secret, origins_php
# are already set above.

ynh_config_add --template="config.php.tpl" --destination="$install_dir/www/os/config.php"
chmod 640 "$install_dir/www/os/config.php"

ynh_config_add --template="analytics-config.php.tpl" --destination="$install_dir/www/os/data/analytics/config.php"
chmod 640 "$install_dir/www/os/data/analytics/config.php"

# Patch landing: path prefix + tracker
landing="$install_dir/www/index.html"
if [[ -f "$landing" ]]; then
  # Rewrite default /site/ asset base if custom path
  if [[ "$path" != "/site" ]]; then
    ynh_replace --match="/site/" --replace="${path%/}/" --file="$landing"
  fi
  # Ensure tracker points at OS collector with generated key
  if grep -q 'os/a/t.js' "$landing"; then
    sed -i -E "s#src=\"[^\"]*os/a/t\\.js\"#src=\"${path%/}/os/a/t.js\"#g" "$landing"
    sed -i -E "s#data-k=\"[^\"]*\"#data-k=\"${site_key}\"#g" "$landing"
  else
    sed -i "s#</body>#    <script defer src=\"${path%/}/os/a/t.js\" data-k=\"${site_key}\"></script>\n  </body>#" "$landing"
  fi
fi

# Store secrets needed later (not the PHP admin password long-term beyond seed)
ynh_app_setting_set --key=site_key --value="$site_key"
ynh_app_setting_set --key=python_url --value="https://${dashboard_domain}"

#=================================================
# PYTHON DASHBOARD VENV + ADMIN
#=================================================
ynh_script_progression "Setting up Python dashboard..."

# App user must own dashboard before venv write / create-admin
chown -R "$app:www-data" "$install_dir/dashboard"
chmod 700 "$install_dir/dashboard/data"

sudo -u "$app" python3 -m venv "$install_dir/dashboard/.venv"
sudo -u "$app" "$install_dir/dashboard/.venv/bin/pip" install --upgrade pip
sudo -u "$app" "$install_dir/dashboard/.venv/bin/pip" install -r "$install_dir/dashboard/requirements.txt"

totp_file="$install_dir/dashboard/data/admin-totp.txt"
set +e
out="$(
  cd "$install_dir/dashboard"
  sudo -u "$app" env DASHBOARD_ADMIN_PASSWORD="$password" \
    "$install_dir/dashboard/.venv/bin/python" manage.py create-admin "$dashboard_admin" 2>&1
)"
rc=$?
set -e
printf '%s\n' "$out" > "$totp_file"
chmod 600 "$totp_file"
chown "$app:$app" "$totp_file"
if [[ $rc -ne 0 ]]; then
  ynh_print_warn "Dashboard admin creation reported an error — check $totp_file"
fi
ynh_app_setting_set --key=dashboard_totp_file --value="$totp_file"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations..."

ynh_config_add_phpfpm
ynh_config_add_nginx

# Dashboard nginx fragment on dedicated domain (must already exist in Yunohost + DNS).
if [[ "$dashboard_domain" == "$domain" ]]; then
  ynh_print_warn "dashboard_domain equals site domain — use a dedicated subdomain (e.g. stats.$domain)."
fi
mkdir -p "/etc/nginx/conf.d/${dashboard_domain}.d"
# Drop any stock Debian default site that would show "Welcome to nginx"
rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true
ynh_config_add --template="nginx-dashboard.conf" --destination="/etc/nginx/conf.d/${dashboard_domain}.d/${app}-dashboard.conf"
# Regen so the domain vhost definitely includes *.d fragments, then reload.
yunohost tools regen-conf nginx --force || true
ynh_systemctl --service=nginx --action=reload

ynh_config_add_systemd
yunohost service add "$app" --description="WNDRS Besucher-Analyse Dashboard" --log="/var/log/$app/$app.log"

# Bind dashboard permission to dashboard domain.
# URL format: domain.tld/ — NOT https://… (that becomes domain "https:").
# Allow visitors: dashboard has its own login+TOTP; do not put Yunohost SSO in front.
ynh_permission_url --permission="dashboard" --url="${dashboard_domain}/" --auth_header=false
ynh_permission_update --permission="dashboard" --add="visitors" || true

chown -R "$app:www-data" "$install_dir"
chmod -R u+rwX,g+rX,o= "$install_dir"
chmod 770 "$install_dir/www/os/data" "$install_dir/www/os/uploads" "$install_dir/www/os/data/analytics"
chmod 700 "$install_dir/dashboard/data"

#=================================================
# SEED PHP + ENABLE ANALYTICS
#=================================================
ynh_script_progression "Seeding PHP OS and enabling analytics..."

# Ensure OS data is writable before seed
chown -R "$app:www-data" "$install_dir/www/os/data" "$install_dir/www/os/uploads"
chmod 770 "$install_dir/www/os/data" "$install_dir/www/os/uploads" "$install_dir/www/os/data/analytics"

if [[ -f "$install_dir/www/os/app/seed.php" ]]; then
  sudo -u "$app" php "$install_dir/www/os/app/seed.php" || ynh_print_warn "seed.php reported issues"
fi
if [[ -f "$install_dir/www/os/app/seed_platform.php" ]]; then
  sudo -u "$app" php "$install_dir/www/os/app/seed_platform.php" || true
fi

# Enable analytics settings if DB exists after seed
dbfile="$install_dir/www/os/data/kollektiv.sqlite"
if [[ -f "$dbfile" ]]; then
  sqlite3 "$dbfile" "INSERT OR REPLACE INTO app_settings (key, value, updated_at) VALUES ('analytics.enabled','1',datetime('now'));" || true
  sqlite3 "$dbfile" "INSERT OR REPLACE INTO app_settings (key, value, updated_at) VALUES ('analytics.python_url','https://${dashboard_domain}',datetime('now'));" || true
  sqlite3 "$dbfile" "INSERT OR REPLACE INTO app_settings (key, value, updated_at) VALUES ('analytics.active_site_id','1',datetime('now'));" || true
fi

#=================================================
# START SERVICES
#=================================================
ynh_script_progression "Starting services..."
ynh_systemctl --service="$app" --action="enable"
ynh_systemctl --service="$app" --action="start" --wait_until="Uvicorn running" --log_path="systemd" --timeout=60 || \
  ynh_systemctl --service="$app" --action="restart" --wait_until="Uvicorn running" --log_path="systemd" --timeout=60

ynh_script_progression "Installation of $app completed"
ynh_print_info "Dashboard TOTP secret is in $totp_file (mode 600). Add it to your authenticator, then delete the file."
ynh_print_info "Landing: https://${domain}${path%/}/ — OS: https://${domain}${path%/}/os/ — Dashboard: https://${dashboard_domain}/"
