#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

dashboard_domain=$(ynh_app_setting_get --key=dashboard_domain)

ynh_script_progression "Updating nginx configuration..."
ynh_config_change_url_nginx

# Rewrite PHP base_path / public_home
config="$install_dir/www/os/config.php"
if [[ -f "$config" ]]; then
  new_base="${path%/}/os"
  new_home="${path%/}/"
  [[ "$path" == "/" ]] && new_base="/os" && new_home="/"
  ynh_replace --match="'base_path' => '.*'" --replace="'base_path' => '${new_base}'" --file="$config" || true
  ynh_replace --match="'public_home' => '.*'" --replace="'public_home' => '${new_home}'" --file="$config" || true
fi

wndrs_sync_seo_host "$install_dir" "$domain"
wndrs_rewrite_vite_base "$install_dir" "$path"
wndrs_sync_landing_tracker "$install_dir" "$path"
wndrs_ensure_dashboard_site "$install_dir" "$domain" "$path"
wndrs_ensure_dashboard_public "$dashboard_domain" "$app"

aconf="$install_dir/www/os/data/analytics/config.php"
if [[ -f "$aconf" ]]; then
  ynh_print_info "If the public hostname changed, update collector origins in overrides.php or config.php."
fi

ynh_script_progression "change_url completed"
